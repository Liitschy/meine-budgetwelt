; Engine configuration file.
; Edit preferably through the Godot editor.

config_version=5

[application]

config/name="Budget & Wocheneinkauf"
config/description="Einfache lokale Budgetplanung"
config/version="0.42.0"
config/icon="res://assets/app_icon.svg"
run/main_scene="res://app/Boot.tscn"
boot_splash/image="res://assets/space/cosmic-star-atlas-background.png"
boot_splash/bg_color=Color(0.004, 0.047, 0.067, 1)
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

StorageManager="*res://core/storage_manager.gd"
BudgetManager="*res://core/budget_manager.gd"
FixedCostManager="*res://core/fixed_cost_manager.gd"
SavingsManager="*res://core/savings_manager.gd"
MonthManager="*res://core/month_manager.gd"
TransactionManager="*res://core/transaction_manager.gd"
ShoppingManager="*res://core/shopping_manager.gd"
MealPlanManager="*res://core/meal_plan_manager.gd"
CustomRecipeManager="*res://core/custom_recipe_manager.gd"
AiPlanningManager="*res://core/ai_planning_manager.gd"
BankingManager="*res://core/banking_manager.gd"
SyncManager="*res://core/sync_manager.gd"
UpdateManager="*res://core/update_manager.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_lights_per_object=2
limits/opengl/max_renderable_lights=8
environment/defaults/default_clear_color=Color(0.035, 0.043, 0.075, 1)

[application_update]

manifest_url="https://github.com/unique1986/meine-budgetwelt/releases/latest/download/update-manifest.json"

[application_sync]

server_url="https://budget.leno.info"
